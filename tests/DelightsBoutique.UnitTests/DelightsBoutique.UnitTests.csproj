<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="FluentAssertions" Version="8.11.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DelightsBoutique.Domain\DelightsBoutique.Domain.csproj" />
    <ProjectReference Include="..\..\src\DelightsBoutique.Application\DelightsBoutique.Application.csproj" />
    <!-- Deliberate, scoped exception to the Domain+Application-only convention: PhoneNormalizer
         and OrderIdGenerator live in Infrastructure (per the SystemClock precedent for
         "Application interface, Infrastructure implementation" pairs), but are provably
         I/O-free, so they're unit-tested here rather than only in the Docker-dependent
         integration suite. -->
    <ProjectReference Include="..\..\src\DelightsBoutique.Infrastructure\DelightsBoutique.Infrastructure.csproj" />
  </ItemGroup>

</Project>
