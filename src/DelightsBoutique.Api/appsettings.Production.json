{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "FileStorage": {
    "Provider": "Spaces"
  },
  "Spaces": {
    "Endpoint": "__SET_TO_REAL_SPACES_REGION_ENDPOINT__",
    "Bucket": "__SET_TO_REAL_SPACES_BUCKET_NAME__"
  },
  "Owner": {
    "Email": "__SET_TO_REAL_OWNER_EMAIL__",
    "Name": "__SET_TO_REAL_OWNER_NAME__"
  }
}
