{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "FileStorage": {
    "RootPath": "App_Data/uploads",
    "PublicBaseUrl": "__SET_TO_REAL_STAGING_ORIGIN__"
  },
  "Owner": {
    "Email": "__SET_TO_REAL_OWNER_EMAIL__",
    "Name": "__SET_TO_REAL_OWNER_NAME__"
  }
}
